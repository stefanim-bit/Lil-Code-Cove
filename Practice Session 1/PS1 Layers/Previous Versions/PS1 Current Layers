<link href="https://fonts.googleapis.com/css2?family=Wix+Madefor+Display:wght@400;700;800&family=Wix+Madefor+Text:ital,wght@0,400;0,500;0,600;0,700;1,600&display=swap" rel="stylesheet">

<style>
  :root{
    /* ---- Brand palette (the exact hexes supplied) ---- */
    --ink:#242424; --ink-2:#424242; --muted:#707070;
    --line:#E0E0E0; --line-2:#D1D1D1; --bg:#F5F5F5; --paper:#ffffff;
    --brand:#DA3B01;                 /* Wix orange-red — the End button + accents   */
    --agent:#0F62E6; --agent-deep:#1464A0;  /* agent (you) blue                     */
    --positive:#5BBE7E;
    --agent-bubble:#EAF1FE; --agent-bubble-line:#CFE0FF;
    /* ---- LOCKED end-screen correctness legend (scorecard only) ---- */
    --correct:#38761d; --correct-bg:#D9EAD3;
    --partial:#bf9000;  --partial-bg:#FFF2CC;
    --incorrect:#cc0000;--incorrect-bg:#F4CCCC;
    /* ---- shape ---- */
    --r-lg:1.25rem; --r-md:0.875rem; --r-sm:0.625rem;
    --shadow:0 0.625rem 1.875rem rgba(20,24,40,.10);
    --font-display:'Wix Madefor Display','Wix Madefor Text',system-ui,Arial,sans-serif;
    --font-text:'Wix Madefor Text',system-ui,Arial,Helvetica,sans-serif;
  }
  *{box-sizing:border-box}
  html{font-size:16px}
  html,body{margin:0}
  body{
    font-family:var(--font-text); color:var(--ink); line-height:1.5;
    background:
      radial-gradient(68.75rem 31.25rem at 12% -10%, #EEF3FF 0%, rgba(238,243,255,0) 60%),
      radial-gradient(56.25rem 31.25rem at 105% 0%, #F3F0FA 0%, rgba(243,240,250,0) 55%),
      var(--bg);
    min-height:100vh;
  }
  .app{max-width:66.25rem;margin:0 auto;padding:1.5rem 1.25rem}
  h1,h2,h3{font-family:var(--font-display);letter-spacing:-.01em;margin:0}
  .display{font-weight:800;line-height:1.05}

  /* ============================ MEET THE USER ============================ */
  .meet{
    display:grid;grid-template-columns:0.85fr 1.15fr;gap:0;
    background:var(--paper);border:0.0625rem solid var(--line);border-radius:var(--r-lg);
    box-shadow:var(--shadow);overflow:hidden;min-height:31.25rem;
  }
  .meet .portrait{
    position:relative;
    background:linear-gradient(160deg,#EDF2FE 0%,#F1EEFA 55%,#F6F7FA 100%);
    display:flex;align-items:flex-end;justify-content:center;padding:0 0.75rem;
  }
  .meet .portrait img{max-height:30rem;max-width:100%;object-fit:contain;filter:drop-shadow(0 1.125rem 1.5rem rgba(20,24,40,.16))}
  .meet .portrait .noimg{align-self:center;color:var(--muted);font-size:0.875rem;text-align:center;padding:1.5rem}
  .meet .body{padding:2.75rem 2.75rem 2.5rem;display:flex;flex-direction:column;justify-content:center}
  .eyebrow{font-size:0.8125rem;font-weight:700;color:var(--agent);text-transform:uppercase;letter-spacing:.08em;margin-bottom:0.625rem}
  .meet .body h1{font-size:2.75rem;margin-bottom:1.125rem}
  .meet .body p{font-size:1.0625rem;color:var(--ink-2);margin:0 0 1.75rem;max-width:44ch}

  /* black pill buttons — matches the Rise course (Get Started / Next / Restart) */
  .btn{font-family:var(--font-text);font-weight:700;font-size:0.9375rem;cursor:pointer;border:0;border-radius:62.4375rem;padding:0.8125rem 1.625rem;transition:transform .12s ease, box-shadow .12s ease, background .12s ease}
  .btn:active{transform:translateY(0.0625rem)}
  .btn-dark{background:var(--ink);color:#fff}
  .btn-dark:hover{background:#000}
  .btn-ghost{background:var(--paper);color:var(--ink);border:0.0625rem solid var(--line-2)}
  .btn-ghost:hover{border-color:var(--ink)}

  /* ============================ THE CALL (Communication Panel) ============================ */
  .panel{background:var(--paper);border:0.0625rem solid var(--line);border-radius:var(--r-lg);box-shadow:var(--shadow);overflow:hidden}
  .panel-head{display:flex;align-items:center;gap:0.75rem;padding:0.875rem 1.125rem;border-bottom:0.0625rem solid var(--line);background:#fff}
  .avatar{width:2.375rem;height:2.375rem;border-radius:50%;background:var(--agent);color:#fff;font-weight:700;display:flex;align-items:center;justify-content:center;font-size:0.9375rem;flex:0 0 auto}
  .who-name{font-weight:700;font-size:0.9375rem}
  .who-sub{display:flex;align-items:center;gap:0.5rem;color:var(--muted);font-size:0.78125rem;margin-top:0.0625rem}
  .livedot{width:0.5rem;height:0.5rem;border-radius:50%;background:var(--positive);display:inline-block;box-shadow:0 0 0 0.1875rem rgba(91,190,126,.20)}
  .timer{font-variant-numeric:tabular-nums;font-weight:600;color:var(--ink-2)}
  .head-spacer{flex:1}
  .helperbar-head{display:flex;gap:0.5rem;margin-right:0.5rem}
  .btn-end{background:var(--brand);color:#fff;font-weight:700;font-size:0.8125rem;border:0;border-radius:0.5rem;padding:0.5625rem 1.125rem;cursor:pointer}
  .btn-end:hover{filter:brightness(.94)}


  /* Fixed height so the chat window stays the SAME SIZE for the whole call —
     it no longer grows message-by-message; overflow scrolls internally. */
  /* Fixed-height chat window: it stays ONE consistent size on every screen and
     scrolls internally, so the response options below always sit on screen and
     can be read in full without scrolling the page. 40vh is tuned so the
     options fit for the common (≤4 option) screens. */
  .chat{padding:1rem 1.125rem 0.375rem;display:flex;flex-direction:column;gap:0.875rem;height:40vh;overflow-y:auto}
  .msg{display:flex;flex-direction:column;max-width:78%}
  .msg .meta{font-size:0.6875rem;color:var(--muted);margin:0 0 0.25rem}
  .bubble{padding:0.6875rem 0.875rem;border-radius:1rem;font-size:0.90625rem;line-height:1.45}
  .msg.caller{align-self:flex-start;align-items:flex-start}
  .msg.caller .bubble{background:var(--bg);border:0.0625rem solid var(--line);border-top-left-radius:0.3125rem;color:var(--ink)}
  .msg.you{align-self:flex-end;align-items:flex-end}
  .msg.you .meta{text-align:right;color:var(--agent-deep)}
  .msg.you .bubble{background:var(--agent-bubble);border:0.0625rem solid var(--agent-bubble-line);border-top-right-radius:0.3125rem;color:var(--ink)}
  .msg.system{align-self:center;max-width:90%;align-items:center}
  .msg.system .bubble{background:transparent;border:0;color:var(--muted);font-style:italic;font-size:0.8125rem;padding:0.125rem 0.375rem;text-align:center}
  /* Inline screenshot figure (Layers panel, Accessibility Wizard, etc.) */
  .msg.system .screenshot{margin:0.25rem 0;max-width:100%;display:flex;flex-direction:column;align-items:center}
  .msg.system .screenshot img{max-width:100%;height:auto;border:0.0625rem solid var(--line);border-radius:0.5rem;box-shadow:0 0.125rem 0.5rem rgba(0,0,0,0.08);display:block;cursor:zoom-in}

  /* Lightbox: click-to-enlarge overlay for inline screenshots */
  .lightbox{border:0;padding:0;background:transparent;max-width:95vw;max-height:95vh}
  .lightbox::backdrop{background:rgba(15,17,25,0.82)}
  .lightbox img{display:block;max-width:95vw;max-height:95vh;object-fit:contain;border-radius:0.5rem;box-shadow:0 1.5rem 3rem rgba(0,0,0,0.35)}
  .lightbox-close{position:fixed;top:1rem;right:1.5rem;background:rgba(255,255,255,0.92);border:0;border-radius:50%;width:2.5rem;height:2.5rem;font-size:1.5rem;line-height:1;cursor:pointer;color:var(--ink)}
  .lightbox-close:hover{background:#fff}
  .msg.system .screenshot figcaption{font-size:0.6875rem;color:var(--muted);font-style:italic;margin-top:0.375rem;text-align:center}
  .msg.system .screenshot .noimg{color:var(--muted);font-size:0.8125rem;padding:1rem;border:0.0625rem dashed var(--line);border-radius:0.5rem}

  /* [Action] choices render their result as an inline centered system note in the
     chat stream (reusing .msg.system), so there's no separate action bar. */
  .msg.system .bubble.action{font-style:normal;color:var(--agent);background:var(--agent-bubble);border:0.0625rem solid var(--agent-bubble-line);border-radius:62.4375rem;padding:0.25rem 0.75rem}

  /* Inline notes — the centered "system" bubbles only: an action you take
     ("You clone the site…") or a thing you find ("(You find…)"). These are the
     ONLY lines painted green; caller replies are untouched. */
  .msg.reaction .bubble,
  .msg.reaction .bubble.action{color:#5BBE7E !important}

  /* "Click to view fullscreen" control in the sim header */
  .btn-fs{background:none;border:0;color:var(--muted);font-family:var(--font-text);font-weight:600;font-size:0.78125rem;cursor:pointer;padding:0.4375rem 0.625rem;border-radius:62.4375rem;display:inline-flex;align-items:center;gap:0.375rem}
  .btn-fs:hover{color:var(--agent);background:var(--agent-bubble)}
  .panel:fullscreen{border-radius:0;display:flex;flex-direction:column;overflow:auto}
  .panel:fullscreen .chat{min-height:0;flex:1}

  /* "Action" badge on choices — distinguishes actions (things the Expert DOES)
     from spoken replies, right inside the choice button. */
  .cbadge{display:inline-block;font-weight:700;font-size:0.625rem;text-transform:uppercase;letter-spacing:.05em;color:var(--agent-deep);background:var(--agent-bubble);border:0.0625rem solid var(--agent-bubble-line);border-radius:0.375rem;padding:0.0625rem 0.375rem;margin-right:0.5rem;vertical-align:0.05rem}

  /* composer / decision area — where the real panel's message box sits */
  .composer{border-top:0.0625rem solid var(--line);background:#FBFBFC;padding:0.875rem 1.125rem 1.125rem}
  .helperbar{display:flex;gap:0.5rem;flex-wrap:wrap;margin:0 0 0.75rem}
  .hbtn{font-size:0.78125rem;font-weight:600;padding:0.4375rem 0.8125rem;border-radius:62.4375rem;border:0.0625rem solid var(--line-2);background:#fff;color:var(--ink-2);cursor:pointer}
  .hbtn:hover{border-color:var(--agent);color:var(--agent)}
  .prompt{font-weight:700;font-size:0.875rem;color:var(--muted);text-transform:uppercase;letter-spacing:.05em;margin:0.125rem 0 0.625rem}
  .choice{display:block;width:100%;text-align:left;border:0.0625rem solid var(--line-2);background:#fff;border-radius:var(--r-sm);padding:0.8125rem 0.9375rem;margin:0.5rem 0;font-size:0.90625rem;font-family:var(--font-text);color:var(--ink);cursor:pointer;transition:border-color .12s ease, box-shadow .12s ease, background .12s ease}
  .choice:hover:not(:disabled){border-color:var(--agent);box-shadow:0 0.125rem 0.625rem rgba(15,98,230,.10);background:#fff}
  .choice:disabled{opacity:.45;cursor:not-allowed}
  .next{margin-top:0.75rem}

  /* typing awareness indicator (TAI) — the user "typing…" bubble before a reply */
  .msg.typing .bubble{display:inline-flex;align-items:center;gap:0.3125rem;padding:0.8125rem 0.9375rem}
  .tai-dot{width:0.4375rem;height:0.4375rem;border-radius:50%;background:var(--muted);opacity:.4;animation:tai-blink 1.2s infinite ease-in-out}
  .tai-dot:nth-child(2){animation-delay:.2s}
  .tai-dot:nth-child(3){animation-delay:.4s}
  @keyframes tai-blink{0%,60%,100%{opacity:.25;transform:translateY(0)}30%{opacity:.9;transform:translateY(-0.125rem)}}

  /* learner name field on the Meet screen */
  .namefield{display:flex;flex-direction:column;gap:0.5rem;margin:0 0 1.5rem;max-width:21.25rem}
  .namefield label{font-size:0.8125rem;font-weight:700;color:var(--ink-2)}
  .nameinput{font-family:var(--font-text);font-size:0.9375rem;padding:0.75rem 0.875rem;border:0.0625rem solid var(--line-2);border-radius:var(--r-sm);color:var(--ink);background:#fff}
  .nameinput:focus{outline:none;border-color:var(--agent);box-shadow:0 0 0 0.1875rem rgba(15,98,230,.12)}
  .nameinput.invalid{border-color:#D64545}
  .nameerror{font-size:0.78125rem;color:#D64545}

  /* ============================ COMPLETE ============================ */
  .complete-hero{display:grid;grid-template-columns:0.7fr 1.3fr;gap:0;background:var(--paper);border:0.0625rem solid var(--line);border-radius:var(--r-lg);box-shadow:var(--shadow);overflow:hidden;margin-bottom:1.125rem}
  .complete-hero .portrait{background:linear-gradient(160deg,#EDF2FE 0%,#F1EEFA 55%,#F6F7FA 100%);display:flex;align-items:flex-end;justify-content:center}
  .complete-hero .portrait img{max-height:21.25rem;max-width:100%;object-fit:contain;filter:drop-shadow(0 1rem 1.375rem rgba(20,24,40,.16))}
  .complete-hero .body{padding:2.5rem 2.75rem;display:flex;flex-direction:column;justify-content:center}
  .complete-hero h1{font-size:3rem;margin-bottom:0.75rem}
  .complete-hero .lead{font-size:1rem;color:var(--ink-2);margin:0 0 1.375rem;max-width:46ch}
  .scorenum{font-family:var(--font-display);font-weight:800;font-size:3.5rem;line-height:1}
  .scorenum small{font-size:1.375rem;color:var(--muted);font-weight:700}

  .card{background:var(--paper);border:0.0625rem solid var(--line);border-radius:var(--r-md);padding:1.25rem 1.375rem;margin-top:1rem;box-shadow:0 0.25rem 1rem rgba(20,24,40,.05)}
  .card h3{font-size:0.9375rem;margin:0 0 0.5rem}
  .srow{display:flex;justify-content:space-between;align-items:center;font-size:0.875rem;padding:0.5625rem 0;border-bottom:0.0625rem solid #F1F1F1}
  .srow:last-child{border-bottom:0}
  .sdot{width:0.5625rem;height:0.5625rem;border-radius:50%;margin-right:0.5625rem;display:inline-block}
  .sdot.done{background:var(--correct)} .sdot.partial{background:var(--partial)} .sdot.miss{background:var(--incorrect)}
  .sval{font-variant-numeric:tabular-nums;font-weight:600}
  .list{margin:0.5rem 0 0;padding-left:0;list-style:none}
  .list li{padding:0.5625rem 0 0.5625rem 1.625rem;position:relative;font-size:0.875rem;border-bottom:0.0625rem solid #F4F4F4}
  .list li:last-child{border-bottom:0}
  .list.str li:before{content:"✓";position:absolute;left:0.125rem;color:var(--correct);font-weight:800}
  .list.imp li:before{content:"→";position:absolute;left:0.125rem;color:var(--partial);font-weight:800}
  .pick{font-size:0.78125rem;color:var(--muted);margin-top:0.3125rem;font-style:italic}
  .pick.miss{color:#9aa0a6}
  .actions{display:flex;gap:0.625rem;flex-wrap:wrap;margin-top:1.125rem}
  /* end-screen transcript reuses the LIVE chat bubbles (.msg/.bubble) so it
     mirrors the simulation exactly — gray Sarah left, blue Expert right,
     centered action/system notes. */
  .txchat{display:flex;flex-direction:column;gap:0.75rem;padding:0.5rem 0 0.25rem}

  /* ============================ helper <dialog> ============================ */
  dialog.modal{border:0;border-radius:var(--r-md);max-width:35rem;width:calc(100% - 2rem);padding:0;box-shadow:0 1.5rem 3.75rem rgba(20,24,40,.28)}
  dialog.modal::backdrop{background:rgba(20,24,40,.45)}
  .modal-inner{padding:1.25rem 1.375rem 1.375rem}
  .mhead{display:flex;justify-content:space-between;align-items:center;margin-bottom:0.75rem}
  .mhead h3{font-size:1.0625rem}
  .mx{border:0;background:none;font-size:1.5rem;line-height:1;cursor:pointer;color:var(--muted)}
  .mx:hover{color:var(--ink)}
  .mopt{display:block;width:100%;text-align:left;border:0.0625rem solid var(--line-2);background:#fff;border-radius:var(--r-sm);padding:0.6875rem 0.8125rem;margin:0 0 0.5rem;font-size:0.875rem;font-family:var(--font-text);color:var(--ink);cursor:pointer}
  .mopt:hover{border-color:var(--agent)}
  .tabrow{display:flex;gap:0.375rem;margin-bottom:0.625rem}
  .tab{font-size:0.8125rem;padding:0.4375rem 0.75rem;border-radius:0.5rem;border:0.0625rem solid var(--line-2);background:#fff;font-family:var(--font-text);cursor:pointer}
  .tab.active{border-color:var(--agent);color:var(--agent);font-weight:700}
  .article-body{white-space:pre-wrap;font-size:0.875rem;background:var(--bg);border-radius:var(--r-sm);padding:0.8125rem;min-height:5.625rem;line-height:1.5}
  .mnote{font-size:0.78125rem;color:var(--muted);margin-top:0.5rem}
  .speakerbox{background:var(--bg);border:0.0625rem solid var(--line);padding:0.6875rem 0.8125rem;border-radius:var(--r-sm);font-size:0.875rem}

  /* MDN: honour users who prefer less motion */
  @media (prefers-reduced-motion: reduce){
    *{transition:none !important; scroll-behavior:auto !important}
  }
  @media (max-width:45rem){
    .meet,.complete-hero{grid-template-columns:1fr}
    .meet .portrait,.complete-hero .portrait{min-height:16.25rem}
    .meet .body{padding:1.75rem 1.5rem 2rem}
    .meet .body h1{font-size:2.125rem}
    .complete-hero .body{padding:1.75rem 1.5rem}
    .msg{max-width:88%}
  }
</style>
</head>
