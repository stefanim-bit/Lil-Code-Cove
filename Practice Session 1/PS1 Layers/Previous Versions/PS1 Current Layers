<!-- ============================ THE ENGINE (do not edit) =========================== -->
<script id="engine">
(function(){
  const S = window.SCENARIO;
  const app = document.getElementById('app');
  const U = S.user || { name:(S.userBio? "the user":"User"), image:null, bio:S.userBio||"" };

  const earned = {};        // stageId -> best points (skips are recoverable)
  const status = {};        // stageId -> 'todo' | 'partial' | 'done'
  const decisivePick = {};  // stageId -> the response that set that stage's score
  const transcript = [];    // ordered record of the whole conversation
  const stageCfg = {};      // stageId -> stage config (for additive/max lookups)
  S.stages.forEach(st => { earned[st.id]=0; status[st.id]='todo'; stageCfg[st.id]=st; });
  const maxTotal = S.stages.reduce((a,st)=>a+st.max,0);
  const visitedScreens = new Set();
  const help = { used:false, checkedCorrectArticle:false, openedAnyResourceLink:false };
  // Whether the CURRENT screen's speaker line actually played (passed its
  // speakerIf gate) — read when the choice is recorded so the end-of-call
  // transcript replay matches exactly what the learner saw live.
  let currentSpeakerShown = false;

  /* ---- learner name ----------------------------------------------------
     Captured on the Meet screen. Used to (a) label the learner's own chat
     bubbles, (b) substitute the [name] token anywhere in scenario text, and
     (c) push the value out to a Rise/Storyline "learner_name" variable. */
  let learner_name = "";
  function px(s){ return String(s==null?'':s).replace(/\[name\]/gi, learner_name || "you"); }
  function setLearnerName(v){
    learner_name = (v||"").trim();
    pushRiseVar("learner_name", learner_name);
  }

  /* ---- learner email ---------------------------------------------------
     Also captured on the Meet screen (required, basic format check). Unlike
     the name, it is NOT pushed to a Rise/Storyline variable — it is only
     sent to the telemetry Form (see FIELD_IDS.learner_email below). */
  let learner_email = "";
  function setLearnerEmail(v){ learner_email = (v||"").trim(); }

  // Best-effort write to the host course's variable. Storyline exposes
  // GetPlayer(); Rise/other hosts can listen for the postMessage below.
  function pushRiseVar(name, value){
    try {
      const p = (window.parent && window.parent.GetPlayer && window.parent.GetPlayer())
             || (window.top && window.top.GetPlayer && window.top.GetPlayer());
      if(p && p.SetVar) p.SetVar(name, value);
    } catch(e){}
    try { window.parent && window.parent.postMessage({ type:'setVar', name:name, value:value }, '*'); } catch(e){}
  }

  // Stamp each screen with its own id so retry can re-open it.
  Object.keys(S.screens).forEach(k => { S.screens[k].id = k; });

  /* =========================== TELEMETRY ===========================
     Posts one row per learner action to a Google Form, whose responses feed
     the Sheet. A Google Form's formResponse endpoint accepts anonymous,
     cross-origin POSTs with no auth, no deployment permissions, and no shared
     key — which is why this works where the Apps Script Web App returned 401.
     (This is the same mechanism proven in the working Rise POC.)

     Each field is addressed by its Form `entry.NNN` id, not by column name.
     Body is application/x-www-form-urlencoded (entry.123=value&...). If the
     Form's questions ever change, refresh the ids in FIELD_IDS below by
     opening the live form's prefilled-link tool or viewing its HTML source.

     mode:'no-cors' makes the response opaque, so a rejected/misrouted write is
     invisible here and fails silently. Verify the first run by watching rows
     actually land in the Sheet.

     learner_email IS collected on the Meet screen in this scenario and sent to
     the Form's learner_email field (entry.1276253364). All other values are
     derived dynamically from the scenario/screen, so every scenario self-labels
     with no per-scenario editing here. */
  const TELEMETRY_ENDPOINT = 'https://docs.google.com/forms/d/e/1FAIpQLSegiZwFV7DN-wwWsqnBbrqzJ5yEK-3lk8Zl182M0fMNFYH5hg/formResponse';
  const FIELD_IDS = {
    learner_email:    'entry.1276253364',
    learner_name:     'entry.2005409239',
    attempt_id:       'entry.1673953677',
    course:           'entry.2010105379',
    scene:            'entry.1283761747',
    interaction:      'entry.1781563601',
    question:         'entry.786197073',
    response:         'entry.2057562952',
    correct:          'entry.1897805741',
    points:           'entry.1780599104',
    time_on_step_sec: 'entry.1327709145',
    notes:            'entry.1963386753'
  };
  const TELEMETRY_COURSE = S.title;           // written to the `course` field

  // One id per play-through, so a learner's rows can be grouped in the Sheet.
  const attemptId = 'a' + Date.now().toString(36) + Math.random().toString(36).slice(2, 8);

  // `time_on_step_sec` — seconds between a screen appearing and the learner acting.
  let stepStartedAt = null;
  function markStepStart(){ stepStartedAt = callSeconds; }
  function secondsOnStep(){ return stepStartedAt==null ? '' : Math.max(0, callSeconds - stepStartedAt); }

  // Same idea for the Check Resources modal: seconds since it was opened, not the call clock.
  let resourcesOpenedAt = null;
  function secondsOnResources(){ return resourcesOpenedAt==null ? '' : Math.max(0, callSeconds - resourcesOpenedAt); }

  // verdict -> the `correct` field
  function correctCol(verdict){
    if(verdict==='correct')   return 'yes';
    if(verdict==='partial')   return 'partial';
    if(verdict==='incorrect') return 'no';
    return '';
  }

  function logEvent(evt){
    evt = evt || {};
    // Map this event onto the Form fields.
    const row = {
      learner_email:    learner_email,
      learner_name:     learner_name,
      attempt_id:       attemptId,
      course:           TELEMETRY_COURSE,
      scene:            evt.screen   || '',
      interaction:      evt.stage    || evt.helper || evt.type || '',
      question:         evt.question || '',
      response:         evt.text     || evt.action || '',
      correct:          correctCol(evt.verdict),
      points:           evt.points  == null ? '' : evt.points,
      time_on_step_sec: evt.seconds == null ? '' : evt.seconds,
      notes:            evt.notes    || ''
    };
    // Build the urlencoded body keyed by Form entry ids.
    const body = [];
    for(const k in row){
      if(!FIELD_IDS[k]) continue;              // skip any field without an entry id
      const v = row[k];
      body.push(FIELD_IDS[k] + '=' + encodeURIComponent(v == null ? '' : v));
    }
    try{
      fetch(TELEMETRY_ENDPOINT, {
        method:'POST', mode:'no-cors',
        headers:{'Content-Type':'application/x-www-form-urlencoded;charset=UTF-8'},
        body: body.join('&')
      }).catch(()=>{});  // best-effort telemetry; never blocks the learner's flow
    } catch(e){}
  }

  function escapeHtml(s){ return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;'); }

  /* ---- call timer (authentic Communication-Panel touch) ---- */
  let callSeconds = 0, timerHandle = null;
  function mmss(t){ const m=Math.floor(t/60), s=t%60; return (m<10?'0':'')+m+':'+(s<10?'0':'')+s; }
  function startTimer(){ const el=()=>document.getElementById('timer');
    timerHandle = setInterval(()=>{ callSeconds++; const e=el(); if(e) e.textContent=mmss(callSeconds); }, 1000); }
  function stopTimer(){ if(timerHandle){ clearInterval(timerHandle); timerHandle=null; } }

  let chatEl, composerEl;

  /* =================== PHASE 1 — MEET THE USER =================== */
  function renderMeet(){
    stopTimer();
    const portrait = U.image
      ? `<img src="${escapeHtml(U.image)}" alt="Portrait of ${escapeHtml(U.name)}"
             onerror="this.style.display='none';this.insertAdjacentHTML('afterend','<div class=\\'noimg\\'>[ ${escapeHtml(U.name)} ]<br><span style=&quot;font-size:0.75rem&quot;>character image not found</span></div>')">`
      : `<div class="noimg">[ ${escapeHtml(U.name)} ]</div>`;
    app.innerHTML = `
      <section class="meet">
        <div class="portrait">${portrait}</div>
        <div class="body">
          <div class="eyebrow">Practice Session · User Scenario</div>
          <h1 class="display">Meet ${escapeHtml(U.name)}</h1>
          <p>${escapeHtml(U.bio)}</p>
          <div class="namefield">
            <label for="learnerName">Your name</label>
            <input class="nameinput" id="learnerName" type="text" autocomplete="name"
                   placeholder="Enter your name" value="${escapeHtml(learner_name)}">
            <div class="nameerror" id="nameError" hidden>Please enter your name to continue.</div>
          </div>
          <div class="namefield">
            <label for="learnerEmail">Your email</label>
            <input class="nameinput" id="learnerEmail" type="email" autocomplete="email"
                   placeholder="Enter your email" value="${escapeHtml(learner_email)}">
            <div class="nameerror" id="emailError" hidden>Please enter a valid email to continue.</div>
          </div>
          <div><button class="btn btn-dark" id="startBtn">Start the chat →</button></div>
        </div>
      </section>`;
    const nameInput  = document.getElementById('learnerName');
    const nameError  = document.getElementById('nameError');
    const emailInput = document.getElementById('learnerEmail');
    const emailError = document.getElementById('emailError');
    const emailOk = v => /^\S+@\S+\.\S+$/.test((v||'').trim());
    nameInput.addEventListener('input', e => {
      setLearnerName(e.target.value);
      if(learner_name) { nameError.hidden = true; nameInput.classList.remove('invalid'); }
    });
    emailInput.addEventListener('input', e => {
      setLearnerEmail(e.target.value);
      if(emailOk(learner_email)) { emailError.hidden = true; emailInput.classList.remove('invalid'); }
    });
    document.getElementById('startBtn').onclick = () => {
      setLearnerName(nameInput.value);
      setLearnerEmail(emailInput.value);
      let bad = false;
      if(!learner_name){
        nameError.hidden = false; nameInput.classList.add('invalid'); bad = true;
      }
      if(!emailOk(learner_email)){
        emailError.hidden = false; emailInput.classList.add('invalid'); bad = true;
      }
      if(bad){ (!learner_name ? nameInput : emailInput).focus(); return; }
      startCall();
    };
  }

  /* =================== PHASE 2 — THE LIVE CALL =================== */
  function startCall(){
    const initial = (U.name||'?').trim().charAt(0).toUpperCase();
    app.innerHTML = `
      <section class="panel" id="sim">
        <div class="panel-head">
          <div class="avatar">${escapeHtml(initial)}</div>
          <div>
            <div class="who-name">${escapeHtml(U.name)}</div>
            <div class="who-sub"><span class="livedot"></span> Live chat · <span class="timer" id="timer">00:00</span></div>
          </div>
          <div class="head-spacer"></div>
          <button class="btn-fs" id="fsBtn" type="button" title="Click to view fullscreen">⤢ Click to view fullscreen</button>
          <div class="helperbar-head" id="helperbar"></div>
          <button class="btn-end" id="endBtn">End</button>
        </div>
        <div class="chat" id="chat" aria-live="polite"></div>
        <div class="composer">
          <div id="composer"></div>
        </div>
      </section>`;
    chatEl = document.getElementById('chat');
    composerEl = document.getElementById('composer');
    document.getElementById('endBtn').onclick = confirmEnd;
    // "Click to view fullscreen" — expand the whole sim panel via the Fullscreen API.
    const fsBtn = document.getElementById('fsBtn'), sim = document.getElementById('sim');
    if(fsBtn && sim && document.fullscreenEnabled){
      fsBtn.onclick = ()=>{
        if(document.fullscreenElement) document.exitFullscreen();
        else sim.requestFullscreen().catch(()=>{});
      };
      document.addEventListener('fullscreenchange', ()=>{
        fsBtn.innerHTML = document.fullscreenElement===sim ? '⤡ Exit fullscreen' : '⤢ Click to view fullscreen';
      });
    } else if(fsBtn){ fsBtn.style.display='none'; }
    renderHelpers();
    startTimer();
    renderScreen(S.start, { animateSpeaker:false });  // first line appears immediately
  }

  function confirmEnd(){
    // Ending early is allowed — skips are recoverable, unreached stages simply score 0.
    const dlg = document.createElement('dialog'); dlg.className='modal';
    dlg.innerHTML = `<div class="modal-inner">
        <div class="mhead"><h3>End the chat?</h3></div>
        <p style="font-size:0.875rem;color:var(--ink-2);margin:0 0 1rem">You'll go straight to your results. Anything you haven't done yet won't score.</p>
        <div class="actions" style="margin:0">
          <button class="btn btn-dark" id="endYes">End &amp; see results</button>
          <button class="btn btn-ghost" id="endNo">Keep going</button>
        </div></div>`;
    document.body.appendChild(dlg); dlg.showModal();
    dlg.querySelector('#endNo').onclick = ()=>{ dlg.close(); dlg.remove(); };
    dlg.querySelector('#endYes').onclick = ()=>{ dlg.close(); dlg.remove(); renderFinal(); };
  }

  /* ---- Bubble markup (shared by the LIVE chat and the END transcript) ----
     'system' bubbles are inline notes (pill), used for both tool/observation
     lines and action notes — anything that isn't a direct spoken quote. */
  function bubbleMarkup(kind, text, metaText, reaction){
    const meta = metaText ? `<div class="meta">${escapeHtml(metaText)}</div>` : '';
    const cls  = 'bubble' + (kind==='system' ? ' action' : '');
    const msgCls = 'msg ' + kind + (reaction ? ' reaction' : '');
    const body = escapeHtml(px(text)).replace(/\n/g,'<br>');
    return `<div class="${msgCls}">${meta}<div class="${cls}">${body}</div></div>`;
  }
  function appendNode(html){
    const tmp = document.createElement('div'); tmp.innerHTML = html;
    const node = tmp.firstElementChild;
    chatEl.appendChild(node); chatEl.scrollTop = chatEl.scrollHeight;
    return node;
  }
  function appendBubble(kind, text, reaction){
    const meta = kind==='system' ? '' :
      `${kind==='you' ? (learner_name||'You') : U.name} · ${mmss(callSeconds)}`;
    return appendNode(bubbleMarkup(kind, text, meta, reaction));
  }
  /* Inline action note: an "[Action]" choice is something the Expert DOES, shown
     as a centered system note in the stream (e.g. "You open User Manager."). */
  function actionNoteText(raw){
    const t = stripAction(px(raw)).trim().replace(/\s+/g,' ').replace(/\s*\.\s*$/,'');
    return 'You ' + t.charAt(0).toLowerCase() + t.slice(1);
  }
  function appendActionNote(text){ return appendBubble('system', text, true); }

  /* Inline screen image: a screenshot shown in the stream for a given screen
     (e.g. the Layers panel or the Accessibility Wizard). `img` is {src, alt,
     caption}. Rendered as a full-width figure so learners see the same thing
     the Expert would be looking at. Broken/absent sources hide gracefully. */
  function appendImage(img){
    if(!img || !img.src) return null;
    const alt = escapeHtml(img.alt || '');
    // No caption — learners read the screenshot and locate the info themselves.
    // Click (or Enter/Space) opens the image in a full-screen zoom lightbox.
    return appendNode(
      `<div class="msg system"><figure class="screenshot">`+
      `<img src="${escapeHtml(img.src)}" alt="${alt}" loading="lazy" tabindex="0" role="button" `+
      `aria-label="View larger image" onclick="window.__openLightbox(this.src,this.alt)" `+
      `onkeydown="if(event.key==='Enter'||event.key===' '){event.preventDefault();window.__openLightbox(this.src,this.alt);}" `+
      `onerror="this.closest('figure').innerHTML='<div class=\\'noimg\\'>[ screenshot not found ]</div>'">`+
      `</figure></div>`);
  }

  /* ---- Lightbox: click any inline screenshot to view it enlarged ---- */
  function openLightbox(src, alt){
    const dlg = document.createElement('dialog'); dlg.className='lightbox';
    dlg.innerHTML = `<button class="lightbox-close" aria-label="Close">&times;</button>`+
      `<img src="${escapeHtml(src)}" alt="${escapeHtml(alt||'')}">`;
    document.body.appendChild(dlg); dlg.showModal();
    const close = ()=>{ try{dlg.close();}catch(e){} dlg.remove(); };
    dlg.addEventListener('click', e=>{ if(e.target===dlg) close(); });
    dlg.querySelector('.lightbox-close').onclick = close;
  }
  window.__openLightbox = openLightbox;

  function setComposer(html){ composerEl.innerHTML = html; }

  /* "[Action] ..." choices are actions, not spoken replies. */
  const ACTION_RE = /^\s*\[Action\]\s*/i;
  function isAction(text){ return ACTION_RE.test(text||''); }
  function stripAction(text){ return (text||'').replace(ACTION_RE, ''); }

  /* ---- Split a scripted line (speaker OR consequence) into ordered segments,
     one bubble per speaker. Segments break ONLY at a speaker label at the start
     of a line — NOT at blank lines — so a single message that contains its own
     paragraph break (e.g. the "Set to Advanced" upgrade steps) stays one bubble.
       "Expert:"            -> your blue bubble (right)
       "Sarah:"/name/caller -> gray caller bubble (left)
       "(...)"              -> inline system note (tool result / stage direction)
       unlabeled            -> caller (spoken) by default
     Speaker labels, wrapping quotes, and the ( ) around system notes are
     stripped so bubbles read as clean chat. ---- */
  const YOU_LABEL = /^\s*expert\s*[:：]\s*/i;
  function callerLabelRe(){
    const nm = (U.name||'').replace(/[.*+?^${}()|[\]\\]/g,'\\$&');
    return new RegExp('^\\s*(?:' + (nm?nm+'|':'') + 'sarah|caller|customer)\\s*[:：]\\s*','i');
  }
  function stripQuotes(s){ return s.replace(/^\s*["'“”‘’]+/,'').replace(/["'“”‘’]+\s*$/,'').trim(); }
  function splitDialogue(text){
    if(!text) return [];
    const clr = callerLabelRe(); const segs=[]; let cur=null;
    String(text).split('\n').forEach(line=>{
      if(YOU_LABEL.test(line)){ cur={kind:'you',    text:line.replace(YOU_LABEL,'')}; segs.push(cur); }
      else if(clr.test(line)){  cur={kind:'caller', text:line.replace(clr,'')};        segs.push(cur); }
      else if(!cur && /^\s*\(/.test(line)){ cur={kind:'system', text:line};            segs.push(cur); }
      else if(!cur){            cur={kind:'caller', text:line};                         segs.push(cur); }
      else cur.text += '\n' + line;
    });
    return segs.map(s=>{
      let t = s.kind==='system' ? s.text.replace(/^\s*\(/,'').replace(/\)\s*$/,'') : s.text;
      return { kind:s.kind, text:stripQuotes(t) };
    }).filter(s=>s.text.length);
  }
  /* transcript bubbles: same markup, name label only (no live timer) */
  function segMarkup(kind, text){
    const who = kind==='system' ? '' : (kind==='you' ? (learner_name||'You') : U.name);
    return bubbleMarkup(kind, text, who);
  }

  /* ---- Typing indicator + auto-advance reveal ----
     Sarah's "typing…" dots show before her first reply to a pick; follow-on
     caller lines in the same beat use a shorter delay; your/system lines appear
     after a short beat. animate=false reveals everything at once (first load). */
  const TAI_MS = 5000, TAI_FOLLOW_MS = 1500, YOU_MS = 700, SYS_MS = 500;
  // Consequence beats:
  //  • inline notes (centered system bubbles) reveal 2s apart;
  //  • spoken consequence lines (Samantha OR the Expert) show a 5s typing
  //    indicator before landing.
  const REACT_INLINE_MS = 2000, REACT_TYPING_MS = 5000;
  function typingBubble(kind){
    const you = kind==='you';
    const side = you ? 'you' : 'caller';
    const who  = you ? (learner_name||'You') : U.name;
    return appendNode(
      `<div class="msg typing ${side}"><div class="meta">${escapeHtml(who)} · typing…</div>`+
      `<div class="bubble"><span class="tai-dot"></span><span class="tai-dot"></span><span class="tai-dot"></span></div></div>`);
  }
  function revealSegments(segs, animate, done, opts){
    opts = opts || {};
    const reaction = !!opts.reaction;
    let i=0, sawCaller=false;
    (function next(){
      if(i>=segs.length){ if(done) done(); return; }
      const s=segs[i++];
      // In a consequence (reaction) reveal:
      //  • centered inline notes (system) turn green and reveal 2s apart;
      //  • spoken lines — Samantha (caller) OR the Expert (you) — show a 5s
      //    typing indicator, then land.
      const inlineNote = reaction && s.kind==='system';
      if(!animate){ appendBubble(s.kind, s.text, inlineNote); return next(); }
      if(inlineNote){
        setTimeout(()=>{ appendBubble('system', s.text, true); next(); }, REACT_INLINE_MS);
      } else if(reaction && (s.kind==='caller' || s.kind==='you')){
        const dots=typingBubble(s.kind);
        setTimeout(()=>{ dots.remove(); appendBubble(s.kind, s.text); next(); }, REACT_TYPING_MS);
      } else if(s.kind==='caller'){
        const t = sawCaller ? TAI_FOLLOW_MS : TAI_MS; sawCaller=true;
        const dots=typingBubble();
        setTimeout(()=>{ dots.remove(); appendBubble('caller', s.text); next(); }, t);
      } else {
        setTimeout(()=>{ appendBubble(s.kind, s.text); next(); }, s.kind==='you'?YOU_MS:SYS_MS);
      }
    })();
  }

  /* ---- Helper buttons (native <dialog>) ---- */
  function openModal(title, node){
    const dlg = document.createElement('dialog'); dlg.className='modal'; dlg.id='modal';
    const inner = document.createElement('div'); inner.className='modal-inner';
    const head = document.createElement('div'); head.className='mhead';
    head.innerHTML = `<h3>${escapeHtml(title)}</h3>`;
    const x = document.createElement('button'); x.className='mx'; x.innerHTML='&times;'; x.setAttribute('aria-label','Close');
    x.onclick = closeModal; head.appendChild(x);
    inner.appendChild(head); inner.appendChild(node); dlg.appendChild(inner);
    document.body.appendChild(dlg); dlg.showModal();
    dlg.addEventListener('click', e=>{ if(e.target===dlg) closeModal(); });  // backdrop click
  }
  function closeModal(){ const m=document.getElementById('modal'); if(m){ try{m.close();}catch(e){} m.remove(); } }

  function renderHelpers(){
    const bar = document.getElementById('helperbar');
    if(!S.resources){ bar.style.display='none'; return; }
    bar.innerHTML='';
    const b=document.createElement('button');
    b.className='hbtn';
    b.textContent = S.resources.title || 'Check Resources';
    b.onclick = openResources;
    bar.appendChild(b);
  }
  /* Opens the scenario's dynamic links in a modal. Opening the resource
     marked correct:true is what lifts the article-stage cap in renderFinal —
     but only if it happens at/after RESOURCE_CREDIT_MIN_SECONDS into the call.
     Opening it earlier doesn't count; the learner can still open it again
     later (any time before ending the chat) to earn credit. */
  const RESOURCE_CREDIT_MIN_SECONDS = 30;
  function openResources(){
    const r=S.resources, wrap=document.createElement('div');
    resourcesOpenedAt = callSeconds;   // start the clock for this modal's dwell time
    logEvent({type:'helper', helper:'resources', action:'opened Check Resources', seconds:0});
    if(r.note) wrap.innerHTML='<div class="mnote" style="margin:0 0 0.625rem">'+escapeHtml(r.note)+'</div>';
    (r.items||[]).forEach(it=>{
      const a=document.createElement('a');
      a.className='mopt'; a.href=it.url||'#'; a.target='_blank'; a.rel='noopener noreferrer';
      a.textContent=it.label + '  ↗';
      a.onclick=()=>{
        // Any resource link click (correct or distractor) counts as "opened a
        // resource" — this gates speaker lines like "(You open CSI.)" that
        // should only appear if the learner actually looked something up.
        help.openedAnyResourceLink = true;
        if(it.correct){
          if(callSeconds >= RESOURCE_CREDIT_MIN_SECONDS){
            help.checkedCorrectArticle=true;
            logEvent({type:'helper', helper:'resources', action:it.label,
                      verdict:'correct', seconds:secondsOnResources(), notes:'opened the correct resource'});
          } else {
            logEvent({type:'helper', helper:'resources', action:it.label,
                      seconds:secondsOnResources(), notes:'opened the correct resource too early to earn credit (before '+RESOURCE_CREDIT_MIN_SECONDS+'s)'});
          }
        } else logEvent({type:'helper', helper:'resources', action:it.label,
                         verdict:'incorrect', seconds:secondsOnResources(), notes:'opened a distractor resource'});
      };
      wrap.appendChild(a);
    });
    openModal(r.title||'Check Resources', wrap);
    document.getElementById('modal').addEventListener('close', ()=>{
      logEvent({type:'helper', helper:'resources', action:'closed Check Resources', seconds:secondsOnResources()});
    }, {once:true});
  }

  /* Centered in-sim notice (styled like the Check Resources panel) shown when a
     learner tries to reply from an article they never opened in Check Resources —
     replaces the old browser alert(). */
  function notifyResourceNotOpened(){
    const wrap=document.createElement('div');
    wrap.innerHTML='<div class="mnote" style="margin:0;font-size:0.875rem;color:var(--ink-2)">'
      + 'It looks like you didn’t open this article using Check Resources. '
      + 'Remember to always check the resource before answering from memory.</div>';
    openModal('Check the resource first', wrap);
  }

  /* Progress bar removed — kept as a no-op so existing call sites are harmless. */
  function paintProgress(){}

  function applyCredit(stg, pts, verdict, pickText){
    if(!(stg in earned)) return;
    const cfg = stageCfg[stg] || {};
    if(cfg.additive){
      // Stage spans more than one screen (e.g. solve = s_solve + s_solve2):
      // sum contributions, capped at the stage max, rather than taking the best.
      const next = Math.min(cfg.max==null ? Infinity : cfg.max, earned[stg] + Math.max(0, pts));
      if(pts > 0 || !(stg in decisivePick)) decisivePick[stg] = {text:pickText, verdict:verdict, points:next};
      earned[stg] = next;
      if(verdict==='correct') status[stg]='done';
      else if(verdict==='partial' && status[stg]!=='done') status[stg]='partial';
      return;
    }
    if(!(stg in decisivePick) || pts > earned[stg]) decisivePick[stg] = {text:pickText, verdict:verdict, points:pts};
    if(pts > earned[stg]) earned[stg] = pts;
    if(verdict==='correct') status[stg]='done';
    else if(verdict==='partial' && status[stg]!=='done') status[stg]='partial';
  }
  function recordChoice(screen, ch, cappedPoints){
    const primary = ch.stageOverride || screen.stage;
    applyCredit(primary, cappedPoints, ch.verdict, ch.text);
    (ch.credits||[]).forEach(c => applyCredit(c.stage, c.points, c.verdict||'correct', ch.text));
  }

  function renderScreen(id, opts){
    opts = opts || {};
    const retriedIds = opts.retriedIds || [];
    if(id==='__end__') return renderFinal();
    const scr = S.screens[id];
    visitedScreens.add(scr.id);
    paintProgress();
    setComposer('');   // choices appear only AFTER the caller's line has landed

    const showChoices = ()=>{
      // (Screen screenshots are no longer shown automatically — they now reveal
      //  only when the learner picks the choice flagged with caption:"Samantha's Layers panel…".)
      setComposer(`<div class="prompt">${escapeHtml(px(scr.prompt))}</div><div id="choices"></div>`);
      const cWrap = document.getElementById('choices');
      scr.choices.forEach(ch=>{
        const b=document.createElement('button');
        // A choice with `say` is the Expert SPEAKING (rendered as a bubble), so
        // it isn't a tool action — no badge, even if its label reads "[Action]".
        const badge = isAction(ch.text) && !ch.say;
        b.className = 'choice' + (badge ? ' choice-action' : '');
        b.innerHTML = (badge ? '<span class="cbadge">Action</span>' : '')
                    + escapeHtml(stripAction(px(ch.text)));
        if(retriedIds.includes(ch.id)) b.disabled=true;
        b.onclick=()=>choose(scr,ch,retriedIds,opts.cap);
        cWrap.appendChild(b);
      });
      markStepStart();   // start the clock for this screen's time_on_step_sec
    };

    // The caller line (which may itself contain Expert:/Sarah: parts) is split
    // into its own bubbles. On auto-advance it animates in with typing dots.
    currentSpeakerShown = !!(scr.speaker && !opts.skipSpeaker && speakerGateMet(scr));
    if(currentSpeakerShown){
      revealSegments(splitDialogue(scr.speaker), !!opts.animateSpeaker, showChoices);
    } else {
      showChoices();
    }
  }

  /* Some speaker lines only make sense if the learner actually did something
     first. `speakerIf:"resourceOpened"` on a screen gates its speaker line so
     it's skipped entirely unless the learner clicked a resource link in Check
     Resources at some point in the call. Add more gate keys here as needed. */
  function speakerGateMet(scr){
    if(!scr.speakerIf) return true;
    if(scr.speakerIf === 'resourceOpened') return !!help.openedAnyResourceLink;
    return true;
  }

  function choose(scr, ch, retriedIds, cap){
    [...composerEl.querySelectorAll('.choice')].forEach(x=>x.disabled=true);
    // The learner's pick renders as:
    //   • `say` present  -> a blue Expert bubble of the spoken words ("Tell Sarah…")
    //   • an [Action]    -> an inline "You …" note (a tool action)
    //   • otherwise      -> a blue reply bubble of the choice text
    if(ch.say) appendBubble('you', ch.say);
    else if(isAction(ch.text)) appendActionNote(actionNoteText(ch.text));
    else appendBubble('you', ch.text);

    // Choice-gated screenshot: shows immediately on selection, before the reply.
    if(ch.showsImage && scr.image) appendImage(scr.image);
    // Deferred screenshot: shown AFTER the consequence (reply) finishes revealing.
    const showImageAfter = ()=>{ if(ch.showsImageAfter && scr.image) appendImage(scr.image); };
    const segs = splitDialogue(ch.consequence);

    if(ch.retry && !retriedIds.includes(ch.id)){
      transcript.push({ speaker:currentSpeakerShown ? scr.speaker : null, picked:ch.text, say:ch.say, consequence:ch.consequence });
      logEvent({ type:'choice', stage:scr.stage, screen:scr.id, question:px(scr.prompt),
                 text:stripAction(px(ch.text)), verdict:ch.verdict, points:0, seconds:secondsOnStep(),
                 notes:'first attempt — caller pushed back, screen re-opened for a retry (capped at '+ch.capIfRetried+')' });
      setComposer('');
      // Auto-advance: once the pushback lands, re-open the same screen (no button).
      revealSegments(segs, true, ()=>renderScreen(scr.id,
        { retriedIds:retriedIds.concat(ch.id), cap:ch.capIfRetried, skipSpeaker:true }), { reaction:true });
      return;
    }

    let pts = ch.points;
    if(typeof cap === 'number') pts = Math.min(pts, cap);
    recordChoice(scr, ch, pts);
    logEvent({ type:'choice', stage:scr.stage, screen:scr.id, question:px(scr.prompt),
               text:stripAction(px(ch.text)), verdict:ch.verdict, points:pts, seconds:secondsOnStep(),
               notes:(isAction(ch.text) ? 'action' : 'reply')
                     + (typeof cap==='number' ? '; retry attempt, capped at '+cap : '') });
    transcript.push({ speaker:(typeof cap==='number'?null:scr.speaker), picked:ch.text, say:ch.say, consequence:ch.consequence });

    setComposer('');
    // Auto-advance to the next screen — NO Continue button. The next caller line
    // arrives via its own typing indicator, straight into the next choices.
    revealSegments(segs, true, ()=>{
      showImageAfter();
      if(ch.goTo==='__end__') renderFinal();
      else renderScreen(ch.goTo, { animateSpeaker:true });
    }, { reaction:true });
  }

  /* =================== PHASE 3 — COMPLETE =================== */
  function renderFinal(){
    stopTimer();

    // Apply the Check-Resources penalty before tallying (same rule the old
    // "Check the Articles" used: no verify of the correct resource → capped).
    const helpNotes = [];
    const res = S.resources;
    if(res && !help.checkedCorrectArticle && (res.stage in earned) && earned[res.stage] > res.capIfUnchecked){
      earned[res.stage] = res.capIfUnchecked;
      helpNotes.push("You reached the right answer, but didn't verify it in the source resource — checking the resource is the skill, not remembering.");
    }
    S.stages.forEach(st=>{ if(earned[st.id] >= st.max) status[st.id]='done'; else if(earned[st.id] > 0 && status[st.id]==='done') status[st.id]='partial'; });

    const sum = Object.values(earned).reduce((a,b)=>a+b,0);

    // One summary row per attempt: the total score only.
    logEvent({ type:'final', points:sum, seconds:callSeconds,
               notes:'final score ' + sum + ' / ' + maxTotal });

    const rows = S.stages.map(st=>{
      const cls = status[st.id]==='done'?'done':status[st.id]==='partial'?'partial':'miss';
      return `<div class="srow"><span><span class="sdot ${cls}"></span>${st.name}</span>
              <span class="sval">${earned[st.id]} / ${st.max}</span></div>`;
    }).join('');

    const pickLine = st => {
      const p = decisivePick[st.id];
      return p ? `<div class="pick">Your response: “${escapeHtml(p.text)}”</div>`
               : `<div class="pick miss">You didn't reach this step.</div>`;
    };
    const strengths = S.stages.filter(st=>status[st.id]==='done' && st.strength)
        .map(st=>`<li><b>${st.name}</b> — ${st.strength}${pickLine(st)}</li>`).join('');
    const areas = S.stages.filter(st=>status[st.id]!=='done' && st.improvement)
        .map(st=>`<li><b>${st.name}</b> — ${st.improvement}${pickLine(st)}</li>`).join('');

    const portrait = U.image
      ? `<img src="${escapeHtml(U.image)}" alt="" onerror="this.style.display='none'">` : '';

    app.innerHTML = `
      <section class="complete-hero">
        <div class="portrait">${portrait}</div>
        <div class="body">
          <h1 class="display">Complete!</h1>
          <p class="lead">Here's how the chat went, stage by stage — with the exact response that set each score.</p>
          <div class="scorenum">${sum}<small> / ${maxTotal}</small></div>
        </div>
      </section>

      <div class="card">
        <h3>Scorecard</h3>${rows}
      </div>

      <div class="card">
        <h3 style="color:var(--correct)">Top strengths</h3>
        <ul class="list str">${strengths || '<li>No stage was completed to full marks this time.</li>'}</ul>
      </div>

      <div class="card">
        <h3 style="color:var(--partial)">Areas for improvement</h3>
        <ul class="list imp">${areas || '<li>Nothing flagged — a clean run.</li>'}</ul>
      </div>

      ${helpNotes.length ? `<div class="card"><h3>Notes</h3><ul class="list imp">${helpNotes.map(n=>`<li>${n}</li>`).join('')}</ul></div>` : ''}

      <div class="actions">
        <button class="btn btn-ghost" id="txBtn">View conversation transcript</button>
        <button class="btn btn-dark" onclick="location.reload()">Restart</button>
      </div>
      <div id="tx" class="card" style="display:none"></div>`;

    document.getElementById('txBtn').onclick = () => {
      const tx = document.getElementById('tx'), btn = document.getElementById('txBtn');
      if(tx.style.display==='none'){
        // Mirror the live chat: split speaker/consequence into speaker bubbles,
        // render the pick as an action note or a blue reply bubble.
        tx.innerHTML = `<h3 style="margin-bottom:0.375rem">Conversation transcript</h3>` +
          `<div class="chat txchat">` +
          transcript.map(t=>{
            let h='';
            if(t.speaker) splitDialogue(t.speaker).forEach(s=> h+=segMarkup(s.kind, s.text));
            h += t.say ? segMarkup('you', t.say)
               : isAction(t.picked) ? bubbleMarkup('system', actionNoteText(t.picked), '')
               : segMarkup('you', t.picked);
            if(t.consequence) splitDialogue(t.consequence).forEach(s=> h+=segMarkup(s.kind, s.text));
            return h;
          }).join('') + `</div>`;
        tx.style.display='block'; btn.textContent='Hide conversation transcript';
      } else { tx.style.display='none'; btn.textContent='View conversation transcript'; }
    };
  }

  /* ---- boot ---- */
  renderMeet();
})();
</script>
</body>
</html>
