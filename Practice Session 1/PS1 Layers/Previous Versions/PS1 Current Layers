<!-- ============================ THE SCENARIO (edit this) ============================ -->
<script id="scenario">
window.SCENARIO = {
  title: "Practice Call — Wix Editor: Layers",

  user: {
    name: "Samantha",
    image: null,
    bio: "Samantha made changes to her page layers and the changes are all out of place after saving. In this activity, you'll simulate a chat with her. Click “Resources” to view internal and external help documents at any point during the interaction. Let's begin!"
  },

  resources: {
    title: "Check Resources",
    stage: "article", capIfUnchecked: 10,
    note: "Open the resources below. Checking the right ones before you answer is the skill — not remembering it.",
    items: [
      { label:"Wix Editor: Identifying Editor Elements", url:"https://csinternal.wixanswers.com/kb/en/article/wix-editor-identifying-editor-elements", correct:true },
      { label:"Wix Editor: Elements, Text & Repeater Issues", url:"https://csinternal.wixanswers.com/kb/en/article/wix-editor-elements-text-repeater-issues", correct:true },
      { label:"Products Crossover Guide", url:"https://csinternal.wixanswers.com/kb/en/article/products-crossover-guide" },
      { label:"Wix Editor: Troubleshooting Common Issues (Elements Moving)", url:"https://csinternal.wixanswers.com/kb/en/article/wix-editor-troubleshooting-common-issues-elements-moving" },
      { label:"Wix Editor: Menus, Anchors, Backgrounds", url:"https://support.wix.com/en/article/wix-editor-menus-anchors-backgrounds" },
      { label:"Mobile Editor: Live Site Issues", url:"https://support.wix.com/en/article/mobile-editor-live-site-issues" }
    ]
  },

  stages: [
    { id:"open", name:"Opening & closing", max:5,
      strength:"You greeted Samantha, acknowledged what she'd tried, and closed with a clear recap and an offer of more help.",
      improvement:"Greet Samantha and acknowledge what she described, then close with a short recap and an offer of more help." },
    { id:"dynamics", name:"Use Dynamics", max:10,
      strength:"You looked Samantha up in User Manager to verify her account instead of asking her to describe her setup.",
      improvement:"Look Samantha up in User Manager to verify her account before you start troubleshooting." },
    { id:"familiarize", name:"Familiarize", max:10,
      strength:"You asked a question that tied Samantha's page to her coaching practice, instead of a generic question.",
      improvement:"Ask a question that connects to what Samantha's page is for, her coaching practice, rather than a generic or account-only question." },
    { id:"clarify", name:"Clarify the issue", max:15,
      strength:"You confirmed both the device, desktop, and the exact element, the heart icon, before drawing any conclusion.",
      improvement:"Confirm both the device and the exact element involved before you conclude what's wrong." },
    { id:"roadmap", name:"Roadmapping", max:10,
      strength:"You told Samantha your plan, what you'd check and do next, so she wasn't left guessing.",
